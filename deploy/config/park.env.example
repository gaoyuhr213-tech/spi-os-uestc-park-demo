# 迭代25 · 工单14 · 园区配置包模板（切换园区零代码：复制为 <park>.env 修改后 --env-file 指定）
# ============ 园区标识（单租户物理隔离：每园区一套栈） ============
PARK_ID=uestc
PARK_NAME=电子科大国家大学科技园
APP_VERSION=latest
APP_PORT=3000

# ============ 数据库（OceanBase CE · MySQL 兼容租户） ============
DB_TENANT=spi_os
DB_USER=root
DB_NAME=spi_os
DB_PORT=2881
DB_ROOT_PASSWORD=请修改为强密码
DB_PASSWORD=请修改为强密码

# ============ 应用安全 ============
JWT_SECRET=请生成64位随机字符串

# ============ SSO（可选：接入园区统一身份；留空用本地账号） ============
APP_ID=spi-os-private
OAUTH_SERVER_URL=
OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# ============ 外源连接器（可选：缺省自动降级手工回填，不崩溃） ============
QCC_API_KEY=
QCC_SECRET_KEY=
JOB_BOARD_API_KEY=
